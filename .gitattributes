* text=auto eol=lf

# Keep `git archive` (and therefore the GitHub source zip) small. Go modules are served from the
# repository tree via the module proxy, so this only affects archives.
/.github/ export-ignore
/.editorconfig export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/.golangci.yml export-ignore
/Makefile export-ignore
/scripts/ export-ignore
/CONTRIBUTING.md export-ignore
/CODE_OF_CONDUCT.md export-ignore
/RELEASING.md export-ignore

# Generated code: collapse in diffs.
/models.go linguist-generated=true
/params.go linguist-generated=true
