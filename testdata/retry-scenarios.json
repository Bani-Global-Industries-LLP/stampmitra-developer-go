{
  "$comment": "Retry/idempotency conformance. Defaults: maxRetries=2 (so at most 3 attempts), exponential backoff with full jitter (base 0.5 s, cap 8 s), Retry-After (seconds), when present, overrides computed backoff (the hardened contract documents that the API itself sends no Retry-After on 429, so the computed backoff is the normal path). Retryable: 429, 502, 503, 504, connection errors, timeouts. POST is retried only when an Idempotency-Key is present; verification POSTs (POST /v1/verify/*) are billed, carry no idempotency key and are NEVER retried after a response was received. Sequence items: an HTTP status number, or the strings connection_error (failed before any response bytes) / timeout. `outcome` is the final status or error class.",
  "version": 1,
  "defaults": { "maxRetries": 2, "backoff": { "baseSeconds": 0.5, "capSeconds": 8, "jitter": "full" } },
  "scenarios": [
    { "name": "get-503-503-200", "method": "GET", "path": "/v1/services", "idempotencyKey": false, "sequence": [503, 503, 200], "expectedAttempts": 3, "outcome": 200 },
    { "name": "get-503-200", "method": "GET", "path": "/v1/usage/summary", "idempotencyKey": false, "sequence": [503, 200], "expectedAttempts": 2, "outcome": 200 },
    { "name": "get-200-no-retry", "method": "GET", "path": "/v1/services", "idempotencyKey": false, "sequence": [200], "expectedAttempts": 1, "outcome": 200 },
    { "name": "get-exhausted-503", "method": "GET", "path": "/v1/services", "idempotencyKey": false, "sequence": [503, 503, 503, 200], "expectedAttempts": 3, "outcome": "UpstreamError(503)" },
    { "name": "get-502-504-200", "method": "GET", "path": "/v1/orders/ord_1", "idempotencyKey": false, "sequence": [502, 504, 200], "expectedAttempts": 3, "outcome": 200 },
    { "name": "get-connection-error-then-200", "method": "GET", "path": "/v1/orders/ord_1/status", "idempotencyKey": false, "sequence": ["connection_error", 200], "expectedAttempts": 2, "outcome": 200 },
    { "name": "get-timeout-then-200", "method": "GET", "path": "/v1/orders/ord_1/status", "idempotencyKey": false, "sequence": ["timeout", 200], "expectedAttempts": 2, "outcome": 200 },
    { "name": "get-timeout-exhausted", "method": "GET", "path": "/v1/orders/ord_1/status", "idempotencyKey": false, "sequence": ["timeout", "timeout", "timeout"], "expectedAttempts": 3, "outcome": "TimeoutError" },
    { "name": "get-429-retry-after", "method": "GET", "path": "/v1/logs", "idempotencyKey": false, "sequence": [{ "status": 429, "headers": { "Retry-After": "2" } }, 200], "expectedAttempts": 2, "expectedDelayBeforeAttempt2Seconds": 2, "outcome": 200, "note": "Retry-After (2 s) is honoured instead of the jittered backoff." },
    { "name": "get-429-exhausted", "method": "GET", "path": "/v1/logs", "idempotencyKey": false, "sequence": [{ "status": 429, "headers": { "Retry-After": "1" } }, { "status": 429, "headers": { "Retry-After": "1" } }, { "status": 429, "headers": { "Retry-After": "7" } }], "expectedAttempts": 3, "outcome": "RateLimitError(retryAfter=7)" },
    { "name": "get-404-not-retried", "method": "GET", "path": "/v1/orders/missing", "idempotencyKey": false, "sequence": [404, 200], "expectedAttempts": 1, "outcome": "NotFoundError" },
    { "name": "get-400-not-retried", "method": "GET", "path": "/v1/logs", "idempotencyKey": false, "sequence": [400, 200], "expectedAttempts": 1, "outcome": "ValidationError" },
    { "name": "get-401-not-retried", "method": "GET", "path": "/v1/usage/summary", "idempotencyKey": false, "sequence": [401, 200], "expectedAttempts": 1, "outcome": "AuthenticationError" },
    { "name": "get-403-not-retried", "method": "GET", "path": "/v1/usage/summary", "idempotencyKey": false, "sequence": [403, 200], "expectedAttempts": 1, "outcome": "PermissionError" },
    { "name": "get-max-retries-zero", "method": "GET", "path": "/v1/services", "idempotencyKey": false, "maxRetries": 0, "sequence": [503, 200], "expectedAttempts": 1, "outcome": "UpstreamError(503)" },
    { "name": "get-max-retries-five", "method": "GET", "path": "/v1/services", "idempotencyKey": false, "maxRetries": 5, "sequence": [503, 503, 503, 503, 503, 200], "expectedAttempts": 6, "outcome": 200 },

    { "name": "post-orders-503-503-200-with-key", "method": "POST", "path": "/v1/orders", "idempotencyKey": true, "sequence": [503, 503, 200], "expectedAttempts": 3, "sameIdempotencyKeyAcrossAttempts": true, "outcome": 200 },
    { "name": "post-orders-auto-key-reused", "method": "POST", "path": "/v1/orders", "idempotencyKey": "auto", "sequence": [502, 200], "expectedAttempts": 2, "sameIdempotencyKeyAcrossAttempts": true, "outcome": 200, "note": "SDK generated a UUIDv4 key because the caller supplied none; the same key is sent on every attempt." },
    { "name": "post-payments-intents-429-then-200", "method": "POST", "path": "/v1/payments/intents", "idempotencyKey": true, "sequence": [{ "status": 429, "headers": { "Retry-After": "1" } }, 200], "expectedAttempts": 2, "sameIdempotencyKeyAcrossAttempts": true, "outcome": 200 },
    { "name": "post-parties-connection-error-then-200", "method": "POST", "path": "/v1/estamp/orders/ord_1/parties", "idempotencyKey": true, "sequence": ["connection_error", 200], "expectedAttempts": 2, "sameIdempotencyKeyAcrossAttempts": true, "outcome": 200 },
    { "name": "post-orders-exhausted", "method": "POST", "path": "/v1/orders", "idempotencyKey": true, "sequence": [503, 503, 503, 200], "expectedAttempts": 3, "sameIdempotencyKeyAcrossAttempts": true, "outcome": "UpstreamError(503)" },
    { "name": "post-orders-409-not-retried", "method": "POST", "path": "/v1/orders", "idempotencyKey": true, "sequence": [409, 200], "expectedAttempts": 1, "outcome": "ConflictError" },
    { "name": "post-orders-400-not-retried", "method": "POST", "path": "/v1/orders", "idempotencyKey": true, "sequence": [400, 200], "expectedAttempts": 1, "outcome": "ValidationError" },
    { "name": "post-orders-timeout-with-key-retried", "method": "POST", "path": "/v1/orders", "idempotencyKey": true, "sequence": ["timeout", 200], "expectedAttempts": 2, "sameIdempotencyKeyAcrossAttempts": true, "outcome": 200 },

    { "name": "verify-pan-503-never-retried", "method": "POST", "path": "/v1/verify/pan", "idempotencyKey": false, "billed": true, "sequence": [503, 200], "expectedAttempts": 1, "outcome": "UpstreamError(503)" },
    { "name": "verify-pan-502-never-retried", "method": "POST", "path": "/v1/verify/pan", "idempotencyKey": false, "billed": true, "sequence": [502, 200], "expectedAttempts": 1, "outcome": "UpstreamError(502)" },
    { "name": "verify-gstin-429-never-retried", "method": "POST", "path": "/v1/verify/gstin", "idempotencyKey": false, "billed": true, "sequence": [{ "status": 429, "headers": { "Retry-After": "1" } }, 200], "expectedAttempts": 1, "outcome": "RateLimitError(retryAfter=1)", "note": "A response was received, so the billed POST is not auto-retried even for 429." },
    { "name": "verify-pan-timeout-never-retried", "method": "POST", "path": "/v1/verify/pan", "idempotencyKey": false, "billed": true, "sequence": ["timeout", 200], "expectedAttempts": 1, "outcome": "TimeoutError", "note": "A timeout cannot prove no request bytes reached the server, so it is not retried." },
    { "name": "verify-bank-account-connection-error-pre-response", "method": "POST", "path": "/v1/verify/bank-account", "idempotencyKey": false, "billed": true, "sequence": ["connection_error", 200], "expectedAttempts": 2, "outcome": 200, "optional": true, "note": "OPTIONAL: SDKs that can prove the failure happened before any request was sent (e.g. DNS failure, connection refused) may retry; SDKs that cannot tell must NOT retry (expectedAttempts 1)." },
    { "name": "verify-pan-200-single-attempt", "method": "POST", "path": "/v1/verify/pan", "idempotencyKey": false, "billed": true, "sequence": [200], "expectedAttempts": 1, "outcome": 200 },
    { "name": "verify-pan-negative-result-is-200", "method": "POST", "path": "/v1/verify/pan", "idempotencyKey": false, "billed": true, "sequence": [{ "status": 200, "body": { "referenceId": "SMV-20260927-8F42K7", "valid": false } }], "expectedAttempts": 1, "outcome": 200, "note": "Negative verification results are HTTP 200 and must not be retried or raised." },

    { "name": "get-429-no-retry-after-header", "method": "GET", "path": "/v1/logs", "idempotencyKey": false, "sequence": [429, 200], "expectedAttempts": 2, "outcome": 200, "note": "The real API sends no Retry-After on 429: fall back to the computed (jittered) backoff." },
    { "name": "verify-pan-503-with-idempotency-key-retried", "method": "POST", "path": "/v1/verify/pan", "idempotencyKey": true, "sequence": [503, 200], "expectedAttempts": 2, "sameIdempotencyKeyAcrossAttempts": true, "outcome": 200, "note": "The hardened contract makes verification POSTs idempotent (x-idempotent) when an Idempotency-Key is sent: a retry replays the original result without a second charge. Only SDKs that send a key may retry; keyless verification POSTs stay single-attempt (see verify-pan-503-never-retried)." },
    { "name": "post-replay-no-key-not-retried", "method": "POST", "path": "/v1/webhooks/events/evt_1/replay", "idempotencyKey": false, "sequence": [503, 200], "expectedAttempts": 1, "outcome": "UpstreamError(503)", "note": "POST without an Idempotency-Key is never auto-retried." },
    { "name": "post-duty-calculate-no-key-not-retried", "method": "POST", "path": "/v1/estamp/duty/calculate", "idempotencyKey": false, "sequence": [503, 200], "expectedAttempts": 1, "outcome": "UpstreamError(503)" }
  ]
}
